{
	"$schema": "https://openclaw.ai/schema/config.json",
	"project": {
		"name": "my-pro-website",
		"version": "0.1.0"
	},
	"gateway": {
		"enabled": true,
		"routing": {
			"defaultModel": "google-antigravity/gemini-3-flash",
			"codingModel": "google-antigravity/gemini-3-flash",
			"fastModel": "google-antigravity/gemini-3-flash",
			"reasoningModel": "google-antigravity/gemini-3-flash"
		}
	},
	"tools": {
		"webSearch": {
			"enabled": true
		},
		"webFetch": {
			"enabled": true
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"command": "npx",
				"args": ["-y", "@upstash/context7-mcp"]
			},
			"github": {
				"command": "sh",
				"args": [
					"-c",
					"GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) npx -y @modelcontextprotocol/server-github"
				]
			},
			"playwright": {
				"command": "npx",
				"args": ["-y", "@playwright/mcp@latest"]
			}
		}
	},
	"guardrails": {
		"ignoreFile": ".antigravityignore",
		"restrictedPaths": [
			"node_modules/**",
			".next/**",
			"dist/**",
			".env*",
			"*.log",
			"package-lock.json",
			".openclaw/**"
		]
	}
}
