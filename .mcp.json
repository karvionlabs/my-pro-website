{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"]
		},
		"github": {
			"command": "sh",
			"args": [
				"-c",
				"GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) npx -y @modelcontextprotocol/server-github"
			]
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"]
		}
	}
}
